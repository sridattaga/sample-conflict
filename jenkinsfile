pipeline {
    agent any

    stages {

        stage('Clone') {
            steps {
                git 'https://github.com/<your-username>/website-docker-jenkins.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t website-image .'
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker run -d -p 4000:80 --name website-container website-image'
            }
        }
    }
}
